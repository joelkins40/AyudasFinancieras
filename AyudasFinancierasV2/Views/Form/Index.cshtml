                                                                    <label class="form-check-label">
                                                                        <input type="radio" name="@item1.tipo@item1.id" class="form-check-input input-radio-lg" value="NO" @(item1.respuesta != null && item1.respuesta.Equals("NO") ? "checked" : "") onchange="ocultarDiv(@item1.categoria@item1.posicion)">NO
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    <div class="row g-2 justify-content-center">
                                        <div class="col-auto">
                                            <button type="button" class="btn btn-square btn-primaryYellow px-4 me-2" onclick="goToPrevious(3)">
                                                <i class="fa fa-arrow-circle-left iconos-black" style="font-size: 1rem"></i> Anterior
                                            </button>
                                        </div>
                                        <div class="col-auto">
                                            <button class="btn btn-primaryYellow px-4" data-bs-toggle="modal" data-bs-target="#save">
                                                Enviar respuestas
                                                <i class="fa fa-send iconos-black" aria-hidden="true"></i>
                                                <span id="spinner" class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display:none; margin-left: 5px;"></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="save" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">¿Guardar respuestas?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                </button>
