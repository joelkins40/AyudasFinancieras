    .solo-visible:focus {
        background-color: #f8f9fa !important;
        border-color: #dee2e6 !important;
        box-shadow: none !important;
        outline: none !important;
    }
    .solo-visible::placeholder {
        color: #adb5bd !important;
    }
    /* Deshabilitar clics en la navegación del wizard */
    .nav-wizard li a {
        pointer-events: none !important;
        cursor: default !important;
        position: relative;
        transition: all 0.3s ease;
    }
    .nav-wizard li a:hover {
        text-decoration: none !important;
    }
    /* Estilos mejorados para el paso activo del wizard */
    .nav-wizard li.active a {
        background-color: transparent !important;
        color: #333 !important;
        font-weight: bold !important;
        border-radius: 0 !important;
        padding: 8px 12px !important;
        box-shadow: none !important;
        position: relative;
        border: none !important;
    }
    /* Línea indicadora para el paso activo */
    .nav-wizard li.active a::before {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        right: 0;
        height: 3px;
        background-color: #333 !important;
        border-radius: 2px;
    }
    .nav-wizard li.active a i {
        color: #333 !important;
        background: linear-gradient(135deg, #fff500 0%, #e6dd00 100%) !important;
        border-color: #fff500 !important;
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(255, 245, 0, 0.3);
    }
    .nav-wizard li.active a span {
        color: #333 !important;
        font-weight: 700 !important;
    }
    /* Estilos mejorados para pasos completados */
    .nav-wizard li.completed a {
        background-color: transparent !important;
        color: #6c757d !important;
        border-radius: 0 !important;
        padding: 8px 12px !important;
        border: none !important;
        position: relative;
        opacity: 0.8;
    }
    .nav-wizard li.completed a i {
        color: white !important;
        background: #6c757d !important;
        border-color: #6c757d !important;
        transform: scale(0.95);
    }
    .nav-wizard li.completed a span {
        color: #6c757d !important;
        font-weight: 500 !important;
    }
    /* Agregar un pequeño check mark para pasos completados */
    .nav-wizard li.completed a::after {
        content: '?';
        position: absolute;
        top: -2px;
        right: -2px;
        background-color: #6c757d;
        color: white;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        font-size: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        box-shadow: 0 2px 4px rgba(108, 117, 125, 0.3);
    }
    /* Estilos para pasos no completados (por defecto) */
    .nav-wizard li:not(.active):not(.completed) a {
        background-color: transparent !important;
        color: #6c757d !important;
        border: none !important;
        opacity: 0.6;
        padding: 8px 12px !important;
    }
    .nav-wizard li:not(.active):not(.completed) a i {
        color: #6c757d !important;
        background: rgba(108, 117, 125, 0.1) !important;
        border-color: #dee2e6 !important;
        transform: scale(0.9);
    }
    .nav-wizard li:not(.active):not(.completed) a span {
        color: #6c757d !important;
        font-weight: 400 !important;
    }
    /* Hover effects */
    .nav-wizard li:not(.active) a:hover {
        opacity: 1 !important;
    }
    .nav-wizard li:not(.active) a:hover i {
        transform: scale(1.02) !important;
        background: rgba(255, 245, 0, 0.1) !important;
        border-color: #fff500 !important;
    }
    .nav-wizard li:not(.active) a:hover span {
