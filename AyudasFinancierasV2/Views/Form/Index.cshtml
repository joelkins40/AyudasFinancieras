</div>
<div id="loadingSpinner" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(255,255,255,0.9); z-index:9999; text-align:center;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="text-center">
            <div class="spinner-border" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 fw-bold">Cargando...</p>
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
        // Initialize SmartWizard
        $('#smartwizard').smartWizard({
            selected: 0, // Start with first step
            theme: 'default',
            transition: {
                animation: 'slide-horizontal'
            },
            toolbarSettings: {
                toolbarPosition: 'none', // Ocultar la barra de herramientas completamente
                showNextButton: false,
                showPreviousButton: false
            },
            anchorSettings: {
                enableAllAnchors: true,
                markDoneStep: true,
                markAllPreviousStepsAsDone: true,
                removeDoneStepOnNavigateBack: false,
                enableAnchorOnDoneStep: true
            }
        });
        // Configurar listeners de cambio en campos para validación inmediata
        setupFieldChangeListeners();
        // Inicializar el estado del wizard
        updateWizardStepClasses(0);
        // Detectar cambios en el wizard y actualizar clases
        $('#smartwizard').on("showStep", function(e, anchorObject, stepIndex, stepDirection, stepPosition) {
            updateWizardStepClasses(stepIndex);
        });
        // Handle navigation button clicks
        $('a[href="#datos1"], a[href="#datos2"], a[href="#datos3"], a[href="#datos4"]').on('click', function(e) {
            e.preventDefault();
            var targetStep = $(this).attr('href').replace('#datos', '');
            var stepIndex = parseInt(targetStep) - 1;
            $('#smartwizard').smartWizard("goToStep", stepIndex);
        });
        // Handle custom navigation buttons
        $('.btn[href="#datos1"], .btn[href="#datos2"], .btn[href="#datos3"], .btn[href="#datos4"]').on('click', function(e) {
            e.preventDefault();
            var targetStep = $(this).attr('href').replace('#datos', '');
            var stepIndex = parseInt(targetStep) - 1;
            $('#smartwizard').smartWizard("goToStep", stepIndex);
        });
    });
    // Función para actualizar las clases active y completed de los pasos del wizard
    function updateWizardStepClasses(currentStepIndex) {
        // Obtener todos los elementos li del nav-wizard
        var $navItems = $('#smartwizard .nav-wizard li');
        $navItems.each(function(index) {
            var $li = $(this);
            var $link = $li.find('a.nav-link');
            // Limpiar todas las clases de estado
            $li.removeClass('active completed');
            $link.removeClass('active done');
            if (index < currentStepIndex) {
                // Pasos anteriores al actual son "completed"
                $li.addClass('completed');
                $link.addClass('done');
            } else if (index === currentStepIndex) {
                // El paso actual es "active"
                $li.addClass('active');
                $link.addClass('active');
            }
            // Los pasos posteriores no tienen clases especiales
        });
    }
    function mostrarDiv(id) {
        id = String(id); // Asegurarse de que id sea una cadena
        id = id.replace('.', ''); // Eliminar el punto del id si existe
        var iteme = $('.V' + id);
        iteme.removeAttr('hidden');
        // Buscar el radio button con value="SI" dentro del div identificado por iteme
        var radioButton = iteme.find('input[type="radio"][value="SI"]');
        if (radioButton.length) {
            radioButton.prop('checked', true); // Seleccionar el radio button con value "SI"
            radioButton.trigger('change'); // Lanzar el evento change
        }
        var smart = $('#smartwizard');
        smart.find('.tab-content').css('height', 'auto');
        // Verificar la completitud del paso después de mostrar el div
        setTimeout(function() {
            checkCurrentStepCompletion();
        }, 100);
    }
    function ocultarDiv(id) {
        id = String(id); // Asegurarse de que id sea una cadena
        id = id.replace('.', ''); // Eliminar el punto del id si existe
        var iteme = $('.V' + id);
        iteme.attr('hidden', true);
        // Buscar el radio button con value="NO" dentro del div identificado por iteme
        var radioButton = iteme.find('input[type="radio"][value="NO"]');
        if (radioButton.length) {
            radioButton.prop('checked', true); // Seleccionar el radio button con value "NO"
            radioButton.trigger('change'); // Lanzar el evento change
        }
        var smart = $('#smartwizard');
        smart.smartWizard('resetHeight');
        // Limpiar errores de campos que ahora están ocultos y verificar completitud
        setTimeout(function() {
            clearErrorsFromHiddenFields();
            checkCurrentStepCompletion();
        }, 100);
    }
       $(document).ready(function() {
        @foreach (var item1 in ViewBag.preguntas)
        {
            if (item1.tipo.Equals("SN"))
            {
                if (item1.respuesta != null && item1.respuesta.Equals("SI"))
                    {
                        @:mostrarDiv(@item1.categoria@item1.posicion);
                    }
                    else if (item1.respuesta != null && item1.respuesta.Equals("NO"))
                    {
                        @:ocultarDiv(@item1.categoria@item1.posicion);
                    }
            }
        }
    });
    function guardarEvaluacion() {
        $('#spinner').show();
        var lista = [];
        for (var i = 1; i <= 500; i++) {
            var ite = $('input:radio[name=SN' + i + ']:checked').val();
            if (ite != undefined) {
                lista.push({
                    'id': i,
                    'respuesta': ite
                });
            } else {
                var ite2 = $('input:radio[name=RD' + i + ']:checked').val();
                if (ite2 != undefined) {
                    lista.push({
                        'id': i,
                        'respuesta': ite2
                    });
                } else {
                    var ite3 = $('#TX' + i).val();
                    if (ite3 != undefined) {
                        lista.push({
                            'id': i,
                            'respuesta': ite3
                        });
                    } else {
                        var ite4 = $('#CB' + i).val();
                        if (ite4 != undefined) {
                            lista.push({
                                'id': i,
                                'respuesta': ite4
                            });
                        } else {
                            var ite5 = $('#CBM' + i).val();
                            if (ite5 != undefined) {
                                if (ite5.length === 0 || (ite5.length === 1 && ite5[0] === "0")) {
                                    lista.push({
                                        'id': i,
                                        'respuesta': "NA"
                                    });
                                } else {
                                    lista.push({
                                        'id': i,
                                        'respuesta': ite5.join(',')
                                    });
                                }
                            }
                        }
                    }
                }
            }
        }
        var mensaje = JSON.stringify(
            {
                'pidm': '0013246',
                'nivel': '202010',
                'respuestas': lista
            });
        $.ajax({
            url: '/Form/guardarEvaluacion',
            type: "post",
            contentType: "application/json",
            dataType: "json",
            traditional: true,
            data: mensaje,
            success: function (results) {
                // Ocultar el spinner
                $('#spinner').hide();
                $('#ok').modal('show');
            },
            error: function () {
                // Ocultar el spinner en caso de error
                $('#spinner').hide();
                alert('Error al guardar la evaluación.');
            }
        })
    }
    function redireccionar() {
        // Mostrar el spinner
    $('#loadingSpinner').show();
    // Redireccionar después de un breve retraso para asegurar que el spinner se muestre
    setTimeout(function() {
        window.location.href = '/Becas/Index';
    }, 500); // Puedes ajustar el retraso según sea necesario
    }
    // Función para detectar y marcar el li activo basado en la URL
    function setActiveStepFromURL() {
        var hash = window.location.hash;
        var stepIndex = 0;
        // Mapear hash a índice del paso
        switch(hash) {
            case '#datos1':
                stepIndex = 0;
                break;
            case '#datos2':
                stepIndex = 1;
                break;
            case '#datos3':
                stepIndex = 2;
                break;
            case '#datos4':
                stepIndex = 3;
                break;
            default:
                stepIndex = 0; // Por defecto el primer paso
        }
        // Actualizar el estado visual
        updateWizardStateFromURL(stepIndex);
    }
    // Función para actualizar el estado visual basado en la URL
    function updateWizardStateFromURL(currentStep) {
        $('.nav-wizard li').removeClass('active completed');
        // Marcar pasos completados y activo
        $('.nav-wizard li').each(function(index) {
            if (index < currentStep) {
                $(this).addClass('completed');
            } else if (index === currentStep) {
                $(this).addClass('active');
            }
        });
    }
    // Escuchar cambios en el hash de la URL
    $(window).on('hashchange', function() {
        setActiveStepFromURL();
    });
    // Ejecutar al cargar la página
    $(document).ready(function() {
        setActiveStepFromURL();
        // Configurar listeners para limpiar errores automáticamente
        setupFieldChangeListeners();
        // Detectar clics en botones de navegación y actualizar estado
        $('button[onclick*="smartWizard(\'next\')"]').on('click', function() {
            setTimeout(function() {
                updateActiveStepFromCurrentTab();
            }, 100); // Pequeño delay para que SmartWizard complete el cambio
        });
        $('button[onclick*="smartWizard(\'prev\')"]').on('click', function() {
            setTimeout(function() {
                updateActiveStepFromCurrentTab();
            }, 100); // Pequeño delay para que SmartWizard complete el cambio
        });
        // También detectar eventos del SmartWizard directamente
        $('#smartwizard').on('showStep', function(e, anchorObject, stepIndex, stepDirection) {
            updateWizardStateFromURL(stepIndex);
        });
    });
    // Función para actualizar el estado basado en la pestaña actualmente visible
    function updateActiveStepFromCurrentTab() {
        var activeTabIndex = 0;
        // Buscar cuál tab-pane está activo/visible
        $('#smartwizard .tab-pane').each(function(index) {
            if ($(this).hasClass('active') || $(this).is(':visible')) {
                activeTabIndex = index;
                return false; // break del each
            }
        });
        // Actualizar el estado visual
        updateWizardStateFromURL(activeTabIndex);
        // También actualizar la URL para mantener consistencia
        var newHash = '#datos' + (activeTabIndex + 1);
        if (window.location.hash !== newHash) {
            history.replaceState(null, null, newHash);
        }
    }
    // Función para validar y avanzar al siguiente paso
    function validateAndNext(currentStepIndex) {
        // Limpiar errores previos
        clearValidationErrors();
        // Validar el paso actual
        if (validateCurrentStep(currentStepIndex)) {
            // Si la validación es exitosa, proceder al siguiente paso
            $('#smartwizard').smartWizard('next');
            // Actualizar las clases del wizard después de navegar
            setTimeout(function() {
                updateWizardStepClasses(currentStepIndex + 1);
            }, 100);
        } else {
            // Si hay errores, mostrar mensaje de resumen
            showValidationSummary();
        }
    }
    // Función para limpiar errores de validación
    function clearValidationErrors() {
        $('.form-error').removeClass('form-error');
        $('.validation-error-message').remove();
        $('.validation-summary').hide();
        // Limpiar estilos de radio buttons con error
        $('input[type="radio"]').each(function() {
            $(this).removeClass('form-error');
        });
        // Restaurar color de labels de radio buttons
        $('input[type="radio"] + label, input[type="radio"] ~ label').css({
            'color': '',
            'font-weight': ''
        });
    }
    // Función para limpiar errores de un campo específico
    function clearFieldErrors($field) {
        $field.removeClass('form-error');
        $field.siblings('.validation-error-message').remove();
        // Para selects de Bootstrap Select, también limpiar mensajes después del contenedor dropdown
        if ($field.hasClass('default-select') || $field.hasClass('form-select')) {
            var $dropdownContainer = $field.closest('.dropdown.bootstrap-select');
            if ($dropdownContainer.length > 0) {
                $dropdownContainer.siblings('.validation-error-message').remove();
                // Restaurar estilos normales del contenedor
                $dropdownContainer.css({
                    'border': 'none',
                    'background-color': 'transparent',
                    'box-shadow': 'none',
                    'outline': 'none'
                });
                // Restaurar estilos normales del botón dropdown
                var $dropdownToggle = $dropdownContainer.find('.dropdown-toggle');
                if ($dropdownToggle.length > 0) {
                    $dropdownToggle.css({
                        'border': '2px solid #e9ecef',
                        'background-color': '#ffffff'
                    });
                }
            }
        }
        // Si es un radio button, limpiar todo el grupo
        if ($field.attr('type') === 'radio') {
            var radioName = $field.attr('name');
            var $radioGroup = $('input[name="' + radioName + '"]');
            $radioGroup.removeClass('form-error');
            // Restaurar color de labels del grupo
            $radioGroup.each(function() {
                $(this).next('label').css({
                    'color': '',
                    'font-weight': ''
                });
            });
            // Remover mensajes de error del grupo
            $field.closest('.form-group, .mb-3').find('.validation-error-message').remove();
        }
    }
    // Función para configurar listeners de cambio en los campos
    function setupFieldChangeListeners() {
        // Listener para inputs de texto
        $(document).on('input change', 'input[type="text"], textarea', function() {
            var $field = $(this);
            if ($field.hasClass('form-error')) {
                var value = $field.val();
                if (value && value.trim() !== '') {
                    clearFieldErrors($field);
                }
            }
        });
        // Listener para radio buttons
        $(document).on('change', 'input[type="radio"]', function() {
            var $field = $(this);
            if ($field.is(':checked')) {
                clearFieldErrors($field);
            }
        });
        // Listener para selects
        $(document).on('change', 'select', function() {
            var $field = $(this);
            if ($field.hasClass('form-error')) {
                var value = $field.val();
                if (value && value !== '' && value !== 'Seleccionar opción') {
                    clearFieldErrors($field);
                }
            }
        });
        // Listener específico para Bootstrap Select
        $(document).on('changed.bs.select', 'select.default-select', function() {
            var $field = $(this);
            if ($field.hasClass('form-error')) {
                var value = $field.val();
                if (value && value !== '' && value !== 'Seleccionar opción') {
                    clearFieldErrors($field);
                }
            }
        });
        // Listener para checkboxes
        $(document).on('change', 'input[type="checkbox"]', function() {
            var $field = $(this);
            if ($field.hasClass('form-error') && $field.is(':checked')) {
                clearFieldErrors($field);
            }
        });
        // Verificar si el paso actual está completo después de cada cambio
        $(document).on('input change', 'input, select, textarea', function() {
            setTimeout(function() {
                checkCurrentStepCompletion();
            }, 100);
        });
        // Crear un observer para detectar cuando elementos se muestran u ocultan
        if (typeof MutationObserver !== 'undefined') {
            var observer = new MutationObserver(function(mutations) {
                var shouldRecheck = false;
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && 
                        (mutation.attributeName === 'hidden' || 
                         mutation.attributeName === 'class' || 
                         mutation.attributeName === 'style')) {
                        shouldRecheck = true;
                    }
                });
                if (shouldRecheck) {
                    setTimeout(function() {
                        checkCurrentStepCompletion();
                        // También limpiar errores de campos que ahora están ocultos
                        clearErrorsFromHiddenFields();
                    }, 150);
                }
            });
            // Observar cambios en el contenedor del wizard
            var wizardContainer = document.querySelector('#smartwizard');
            if (wizardContainer) {
                observer.observe(wizardContainer, {
                    attributes: true,
                    childList: true,
                    subtree: true,
                    attributeFilter: ['hidden', 'class', 'style']
                });
            }
        }
    }
    // Función para limpiar errores de campos que ahora están ocultos
    function clearErrorsFromHiddenFields() {
        $('.form-error').each(function() {
            var $field = $(this);
            var $container = $field.closest('.form-group, .mb-3, .col-lg-12, .col-lg-6, .form-check, div[class*="V"]');
            // Si el campo o su contenedor ya no están visibles, limpiar errores
            if (!$field.is(':visible') || 
                $field.is('[hidden]') || 
                $container.is('[hidden]') || 
                $container.hasClass('hidden') ||
                $container.css('display') === 'none') {
                clearFieldErrors($field);
            }
        });
    }
    // Función para verificar si el paso actual está completo y ocultar mensaje de error si es así
    function checkCurrentStepCompletion() {
        var $currentStep = null;
        var currentStepIndex = 0;
        // Encontrar el paso actualmente visible
        $('#smartwizard .tab-pane').each(function(index) {
            if ($(this).hasClass('active') || $(this).is(':visible')) {
                $currentStep = $(this);
                currentStepIndex = index;
                return false; // break
            }
        });
        if (!$currentStep) {
            return;
        }
        // Verificar si el paso está completo (usando la misma lógica de validación pero sin marcar errores)
        var isComplete = isStepComplete(currentStepIndex);
        if (isComplete) {
            // Si el paso está completo, ocultar el mensaje de resumen de errores
            $currentStep.find('.validation-summary').hide();
        }
    }
    // Función para verificar si un paso está completo (sin marcar errores)
    function isStepComplete(stepIndex) {
        var stepId = '#datos' + (stepIndex + 1);
        var $currentStep = $(stepId);
        // Buscar todos los campos que deberían ser validados
        var fieldsToValidate = $currentStep.find('input[type="radio"], select.default-select, input[required], select[required], textarea[required]');
        // Filtrar solo campos visibles
        fieldsToValidate = fieldsToValidate.filter(function() {
            var $field = $(this);
            var $container = $field.closest('.form-group, .mb-3, .col-lg-12, .col-lg-6, .form-check, div[class*="V"]');
            // Verificar si el campo o su contenedor está visible
            return $field.is(':visible') && 
                   !$field.is('[hidden]') && 
                   !$container.is('[hidden]') && 
                   !$container.hasClass('hidden') &&
                   $container.css('display') !== 'none';
        });
        // Agrupar radio buttons por nombre para validarlos como grupo
        var radioGroups = {};
        var isComplete = true;
        fieldsToValidate.each(function() {
            var $field = $(this);
            var fieldType = $field.attr('type');
            var fieldName = $field.attr('name');
            if (fieldType === 'radio') {
                // Agrupar radio buttons por nombre
                if (!radioGroups[fieldName]) {
                    radioGroups[fieldName] = [];
                }
                radioGroups[fieldName].push($field);
            } else {
                // Validar campos individuales (selects, inputs, etc.)
                var fieldValue = $field.val();
                var isFieldValid = true;
                if ($field.is('select')) {
                    // Para selects, verificar si se seleccionó algo diferente a la opción por defecto
                    if (!fieldValue || fieldValue === '' || fieldValue === 'Seleccionar opción') {
                        isFieldValid = false;
                    }
                } else if ($field.attr('required')) {
                    // Para inputs con required, verificar si no está vacío
                    if (!fieldValue || fieldValue.trim() === '') {
                        isFieldValid = false;
                    }
                }
                if (!isFieldValid) {
                    isComplete = false;
                }
            }
        });
        // Validar grupos de radio buttons (solo grupos que tengan al menos un campo visible)
        for (var groupName in radioGroups) {
            var $radioGroup = radioGroups[groupName];
            var isGroupValid = false;
            // Verificar si algún radio del grupo está seleccionado
            for (var i = 0; i < $radioGroup.length; i++) {
                if ($radioGroup[i].is(':checked')) {
                    isGroupValid = true;
                    break;
                }
            }
            if (!isGroupValid) {
                isComplete = false;
            }
        }
        return isComplete;
    }
    // Función para validar el paso actual
    function validateCurrentStep(stepIndex) {
        var isValid = true;
        var stepId = '#datos' + (stepIndex + 1);
        var $currentStep = $(stepId);
        // Buscar todos los campos que deberían ser validados
        // Incluir campos con required y también radio buttons y selects que son parte del formulario
        var fieldsToValidate = $currentStep.find('input[type="radio"], select.default-select, input[required], select[required], textarea[required]');
        // Filtrar solo campos visibles
        fieldsToValidate = fieldsToValidate.filter(function() {
            var $field = $(this);
            var $container = $field.closest('.form-group, .mb-3, .col-lg-12, .col-lg-6, .form-check, div[class*="V"]');
            // Verificar si el campo o su contenedor está visible
            return $field.is(':visible') && 
                   !$field.is('[hidden]') && 
                   !$container.is('[hidden]') && 
                   !$container.hasClass('hidden') &&
                   $container.css('display') !== 'none';
        });
        // Agrupar radio buttons por nombre para validarlos como grupo
        var radioGroups = {};
        fieldsToValidate.each(function() {
            var $field = $(this);
            var fieldType = $field.attr('type');
            var fieldName = $field.attr('name');
            if (fieldType === 'radio') {
                // Agrupar radio buttons por nombre
                if (!radioGroups[fieldName]) {
                    radioGroups[fieldName] = [];
                }
                radioGroups[fieldName].push($field);
            } else {
                // Validar campos individuales (selects, inputs, etc.)
                var fieldValue = $field.val();
                var isFieldValid = true;
                if ($field.is('select')) {
                    // Para selects múltiples, verificar si el array tiene elementos
                    if ($field.attr('multiple')) {
                        // Select múltiple: verificar si hay al menos una opción seleccionada
                        if (!fieldValue || !Array.isArray(fieldValue) || fieldValue.length === 0) {
                            isFieldValid = false;
                        } else {
                            // También verificar que no sean valores vacíos o por defecto
                            var hasValidSelection = false;
                            for (var i = 0; i < fieldValue.length; i++) {
                                if (fieldValue[i] && fieldValue[i] !== '' && fieldValue[i] !== 'Seleccionar opción') {
                                    hasValidSelection = true;
                                    break;
                                }
                            }
                            if (!hasValidSelection) {
                                isFieldValid = false;
                            }
                        }
                    } else {
                        // Select simple: verificar si se seleccionó algo diferente a la opción por defecto
                        if (!fieldValue || fieldValue === '' || fieldValue === 'Seleccionar opción') {
                            isFieldValid = false;
                        }
                    }
                } else if ($field.attr('required')) {
                    // Para inputs con required, verificar si no está vacío
                    if (!fieldValue || fieldValue.trim() === '') {
                        isFieldValid = false;
                    }
                }
                // Si el campo no es válido, marcarlo como error
                if (!isFieldValid) {
                    isValid = false;
                    $field.addClass('form-error');
                    // Para selects de Bootstrap Select, limpiar estilos del contenedor y aplicar al botón
                    if ($field.hasClass('default-select') || $field.hasClass('form-select')) {
                        var $dropdownContainer = $field.closest('.dropdown.bootstrap-select');
                        if ($dropdownContainer.length > 0) {
                            // Limpiar estilos del contenedor
                            $dropdownContainer.css({
                                'border': 'none',
                                'background-color': 'transparent',
                                'box-shadow': 'none',
                                'outline': 'none'
                            });
                            // Aplicar estilos de error al botón dropdown
                            var $dropdownToggle = $dropdownContainer.find('.dropdown-toggle');
                            if ($dropdownToggle.length > 0) {
                                $dropdownToggle.css({
                                    'border': '2px solid #e74c3c',
                                    'background-color': '#fdf2f2'
                                });
                            }
                        }
                    }
                    // Agregar mensaje de error si no existe
                    if ($field.siblings('.validation-error-message').length === 0 && $field.closest('.form-group, .mb-3').find('.validation-error-message').length === 0) {
                        var errorMessage = '<small class="validation-error-message">Este campo es requerido</small>';
                        // Para selects de Bootstrap Select, agregar el mensaje después del contenedor dropdown
                        if ($field.hasClass('default-select') || $field.hasClass('form-select')) {
                            var $dropdownContainer = $field.closest('.dropdown.bootstrap-select');
                            if ($dropdownContainer.length > 0) {
                                $dropdownContainer.after(errorMessage);
                            } else {
                                // Fallback: agregar después del campo si no hay contenedor dropdown
                                $field.after(errorMessage);
                            }
                        } else {
                            // Para otros tipos de campo, agregar después del campo
                            $field.after(errorMessage);
                        }
                    }
                }
            }
        });
        // Validar grupos de radio buttons (solo grupos que tengan al menos un campo visible)
        for (var groupName in radioGroups) {
            var $radioGroup = radioGroups[groupName];
            var isGroupValid = false;
            // Verificar si algún radio del grupo está seleccionado
            for (var i = 0; i < $radioGroup.length; i++) {
                if ($radioGroup[i].is(':checked')) {
                    isGroupValid = true;
                    break;
                }
            }
            // Si ningún radio está seleccionado, marcar error en todo el grupo
            if (!isGroupValid) {
                isValid = false;
                // Marcar todos los radio buttons del grupo como error
                for (var j = 0; j < $radioGroup.length; j++) {
                    $radioGroup[j].addClass('form-error');
                }
                // Agregar mensaje de error al contenedor del grupo si no existe
                var $lastRadio = $($radioGroup[$radioGroup.length - 1]);
                var $container = $lastRadio.closest('.form-group, .mb-3');
                if ($container.find('.validation-error-message').length === 0) {
                    var errorMessage = '<small class="validation-error-message">Debe seleccionar una opción</small>';
                    $container.append(errorMessage);
                }
            }
        }
        return isValid;
    }
    // Función para mostrar resumen de errores de validación
    function showValidationSummary() {
        // Encontrar el paso actualmente visible
        var $currentStep = null;
        $('#smartwizard .tab-pane').each(function() {
            if ($(this).hasClass('active') || $(this).is(':visible')) {
                $currentStep = $(this);
                return false; // break
            }
        });
        if (!$currentStep) {
            $currentStep = $('#smartwizard .tab-pane').first();
        }
        // Buscar el resumen de errores en el paso actual
        var $summary = $currentStep.find('.validation-summary');
        if ($summary.length > 0) {
            $summary.show();
            // Hacer scroll hacia el resumen de errores
            setTimeout(function() {
                $summary[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 100);
        }
    }
    // Función para navegar al paso anterior
    function goToPrevious(currentStepIndex) {
        $('#smartwizard').smartWizard('prev');
        // Actualizar las clases del wizard después de navegar
        setTimeout(function() {
            updateWizardStepClasses(currentStepIndex - 1);
        }, 100);
    }
</script>
