    }
    /* Estilos para validación */
    .form-error {
        border: 2px solid #e74c3c !important;
        background-color: #fdf2f2 !important;
    }
    /* Estilos especiales para radio buttons con error */
    input[type="radio"].form-error {
        outline: 2px solid #e74c3c !important;
        outline-offset: 2px;
    }
    /* Resaltar el label de radio buttons con error */
    input[type="radio"].form-error + label,
    input[type="radio"].form-error ~ label {
        color: #e74c3c !important;
        font-weight: bold;
    }
    .validation-error-message {
        color: #e74c3c;
        font-size: 0.875rem;
        margin-top: 8px;
        display: block;
        font-weight: bold;
    }
    /* Espaciado específico para mensajes de error después de Bootstrap Select */
    .dropdown.bootstrap-select + .validation-error-message {
        margin-top: 5px;
    }
    /* Quitar bordes del contenedor Bootstrap Select */
    .dropdown.bootstrap-select.form-control {
        border: none !important;
        background-color: transparent !important;
        padding: 0 !important;
        box-shadow: none !important;
        outline: none !important;
    }
    /* Quitar bordes cuando el select interno tiene error */
    .dropdown.bootstrap-select.form-control:has(select.form-error),
    .dropdown.bootstrap-select.form-control select.form-error ~ * {
        border: none !important;
        background-color: transparent !important;
        box-shadow: none !important;
        outline: none !important;
    }
    /* Asegurar que solo el botón dropdown tenga el estilo correcto */
    .dropdown.bootstrap-select .dropdown-toggle {
        border: 2px solid #e9ecef !important;
        background-color: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 16px !important;
    }
    /* Estilo del botón cuando el select tiene error */
