    <script>


    function modalEstatus(name, code, estatus) {
        if (estatus === 'Completa') {




            if (code === 'BSA_APP_PRNA_VT' || code === 'BSA_APP_PRRE_VT' || code === 'BSA_APP_BANA_VT' || code === 'BSA_APP_BARE_VT') {
                $('#beca2').text(name);  // Cambiar el nombre del modal

                $('#fake').modal('show');
            } else {




                var mensaje = 'A';
                $('#documentos tbody').empty();  // Limpiar las filas existentes

                $('#beca').text(name);  // Cambiar el nombre del modal

                // Realizar la solicitud AJAX
                $.post("@Url.Action("getEstatus", "Home")", { item: '1' }, function (datas) {

                    // Obtener la instancia de DataTables (que ya está inicializada)
                    var table = $('#documentos').DataTable();
                    table.clear();

                    // Crear un array vacío para las nuevas filas
                    var newRows = [];

                    // Procesar los datos y agregarlos a un array
                    $.each(datas, function (index, item) {
                        var fila = [
                            item.descripcion,
                            item.estatus,
                            getIconByDocumento(item.documento)
                            // Llamamos a una función para obtener el ícono según el tipo de documento
                        ];
                        newRows.push(fila);  // Agregar la fila al array
                    });

                    // Agregar las nuevas filas a DataTables
                    table.rows.add(newRows);  // Añadir las filas a la tabla

                    // Redibujar la tabla para reflejar los cambios
                    table.draw();  // Forzar el redibujado de la tabla

                    // Mostrar el modal
                    $('#ok').modal('show');
                });
            }

        } else {
            $('#beca2').text(name);  // Cambiar el nombre del modal
            $('#beca4').text('Es necesario completar la solicitud, para poder visualizar esta sección');  // Cambiar el nombre del modal

            $('#fake').modal('show');
        }
}

// Función auxiliar para obtener el ícono de acuerdo al tipo de documento
function getIconByDocumento(documento) {
    if (documento === 'PS') {
        return '<i style="color:#d9534f;" class="fa fa-exclamation-circle" aria-hidden="true"></i>';
    } else if (documento === 'COMP' || documento === 'CM') {
        return '<i style="color:#28a745;" class="fa fa-check-circle" aria-hidden="true"></i>';
    } else if (documento === 'NR' || documento === 'PD') {
        return '<i style="color:#fd7e14;" class="fa fa-clock" aria-hidden="true"></i>';
    } else if (documento === 'IN' || documento === 'IV') {
        return '<i style="color:#e83e8c;" class="fa fa-ban" aria-hidden="true"></i>';
    } else {
        return '<i style="color:#6c757d;" class="fa fa-question-circle" aria-hidden="true"></i>';
    }
    }

    function getFile(clave) {
        var width = 800; // Ancho de la ventana
        var height = 600; // Altura de la ventana
        var left = (screen.width / 2) - (width / 2); // Centrar horizontalmente
        var top = (screen.height / 2) - (height / 2); // Centrar verticalmente
        window.open('/Home/DisplayDocument/?documento=' + clave, '_blank', `top=${top},left=${left},width=${width},height=${height},toolbar=1,resizable=1`);
    }

    // Funcionalidad para los botones "Más" del historial de renovaciones
    $(document).ready(function() {
        // Verificar si hay becas disponibles y mostrar el modal
        var becasDisponibles = null;
        
        @if(ViewBag.becas != null) 
        {
            @:becasDisponibles = @Html.Raw(Json.Encode(ViewBag.becas));
        }
        
        if (becasDisponibles && becasDisponibles.length > 0) {
            // Limpiar la tabla antes de llenarla
            $('#tablaBecasDisponibles').empty();
            
            // Actualizar el mensaje dinámicamente según la cantidad de becas
            var cantidadBecas = becasDisponibles.length;
            var mensajeDinamico = '';
            
            if (cantidadBecas === 1) {
                mensajeDinamico = '¡Felicidades! Actualmente tienes 1 ofrecimiento de beca.';
            } else {
                mensajeDinamico = '¡Felicidades! Actualmente tienes ' + cantidadBecas + ' ofrecimientos de beca.';
            }
            
            $('#mensajeBecasDisponibles').text(mensajeDinamico);
            
                // Llenar la tabla con los datos de las becas
                for (var i = 0; i < becasDisponibles.length; i++) {
                    var beca = becasDisponibles[i];
                    var fila = '<tr style="border-bottom: 1px solid #dee2e6;">' +
                        '<td style="color: #333; font-family: \'Montserrat\', sans-serif; padding: 15px;">' + (beca.nombre || beca.descripcion || 'Beca Disponible') + '</td>' +
                        '<td style="color: #333; font-family: \'Montserrat\', sans-serif; padding: 15px;">' + (beca.porcentaje || '') + '</td>' +
                        '<td style="color: #333; font-family: \'Montserrat\', sans-serif; padding: 15px;">' + (beca.fecha || '') + '</td>' +
                        '<td class="opciones-cell" style="color: #333; font-family: \'Montserrat\', sans-serif; padding: 15px;">' +
                            '<button type="button" class="btn btn-beca-action btn-aceptar" onclick="confirmarAceptarBeca(\'' + (beca.code || '') + '\', \'' + (beca.nombre || beca.descripcion || 'Beca Disponible') + '\', \'' + (beca.anio || '') + '\')" data-bs-toggle="tooltip" data-bs-placement="top" title="Aceptar">' +
                                '<i class="fa fa-check" aria-hidden="true"></i>' +
                            '</button>' +
                            '<button type="button" class="btn btn-beca-action btn-rechazar" onclick="confirmarRechazarBeca(\'' + (beca.code || '') + '\', \'' + (beca.nombre || beca.descripcion || 'Beca Disponible') + '\', \'' + (beca.anio || '') + '\')" data-bs-toggle="tooltip" data-bs-placement="top" title="Rechazar">' +
                                '<i class="fa fa-times" aria-hidden="true"></i>' +
                            '</button>' +
                        '</td>' +
                        '</tr>';
                    $('#tablaBecasDisponibles').append(fila);
                }            
            // Mostrar el modal automáticamente después de que la página se haya cargado completamente
            setTimeout(function() {
                $('#modalBecasDisponibles').modal('show');
                
                // Inicializar tooltips después de que se muestre el modal
                setTimeout(function() {
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl);
                    });
                }, 100);
            }, 500);
        }

        // Escuchar eventos de colapso para cambiar el ícono del botón
        $('[id^="detalleRenovacion"]').on('show.bs.collapse', function () {
            var currentId = this.id;

            // Cerrar todos los otros detalles de renovación antes de abrir el actual
            $('[id^="detalleRenovacion"]').each(function() {
                if (this.id !== currentId && $(this).hasClass('show')) {
                    $(this).collapse('hide');
                }
            });

            var button = $('[data-bs-target="#' + this.id + '"]');
            button.find('i').removeClass('fa-plus').addClass('fa-minus');
        });

        $('[id^="detalleRenovacion"]').on('hide.bs.collapse', function () {
            var button = $('[data-bs-target="#' + this.id + '"]');
            button.find('i').removeClass('fa-minus').addClass('fa-plus');
        });
    });

    // Funciones para manejar los modales de confirmación
    function confirmarAceptarBeca(codigoBeca, nombreBeca, anioBeca) {
        // Ocultar todos los tooltips activos
        $('[data-bs-toggle="tooltip"]').tooltip('hide');
        
        $('#nombreBecaAceptar').text(nombreBeca);
        $('#modalConfirmacionAceptar').modal('show');
        
        // Configurar el botón de confirmar
        $('#btnConfirmarAceptar').off('click').on('click', function() {
            aceptarBeca(codigoBeca, nombreBeca, anioBeca);
        });
    }

    function confirmarRechazarBeca(codigoBeca, nombreBeca, anioBeca) {
        // Ocultar todos los tooltips activos
        $('[data-bs-toggle="tooltip"]').tooltip('hide');
        
        $('#nombreBecaRechazar').text(nombreBeca);
        $('#modalConfirmacionRechazar').modal('show');
        
        // Configurar el botón de confirmar
        $('#btnConfirmarRechazar').off('click').on('click', function() {
            rechazarBeca(codigoBeca, nombreBeca, anioBeca);
        });
    }

    function aceptarBeca(codigoBeca, nombreBeca, anioBeca) {
        // Cerrar el modal de confirmación
        $('#modalConfirmacionAceptar').modal('hide');
        
        // Aquí puedes agregar la lógica para procesar la aceptación de la beca
        // Por ejemplo, hacer una llamada AJAX al servidor
        
        // Redirigir a la página de aceptación de beca en la misma ventana
        var url = '@Url.Action("AceptarBeca", "Home")' + '?codigo=' + encodeURIComponent(codigoBeca) + '&anio=' + encodeURIComponent(anioBeca || '');
        window.location.href = url;
    }

    function rechazarBeca(codigoBeca, nombreBeca, anioBeca) {
        // Cerrar el modal de confirmación
        $('#modalConfirmacionRechazar').modal('hide');
        
        // Mostrar indicador de procesamiento
        $('button[onclick*="' + codigoBeca + '"]').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i>');
        
        // Enviar petición AJAX al servidor para rechazar la beca usando el procedimiento Oracle
        $.post('@Url.Action("RechazarBeca", "Home")', { 
            codigo: codigoBeca,
            nombre: nombreBeca,
            anio: anioBeca || new Date().getFullYear()
        }, function(response) {
            if (response.success) {
                // Mostrar mensaje de éxito con mejor UX - sin auto-cerrar
                mostrarNotificacionExitoSinAutoCerrar('¡Beca Rechazada!', response.message);
                
                // Remover la fila de la tabla con animación
                $('button[onclick*="' + codigoBeca + '"]').closest('tr').fadeOut(500, function() {
                    $(this).remove();
                    
                    // Si no quedan más becas, cerrar el modal sin mostrar notificación adicional
                    if ($('#tablaBecasDisponibles tr').length === 0) {
                        $('#modalBecasDisponibles').modal('hide');
                    }
                });
            } else {
                // Mostrar error detallado
                mostrarNotificacionError('Error al rechazar beca', response.message + (response.detalle ? '<br><small>' + response.detalle + '</small>' : ''));
                
                // Restaurar botón
                $('button[onclick*="' + codigoBeca + '"]').prop('disabled', false).html('<i class="fa fa-times" aria-hidden="true"></i>');
            }
        }).fail(function() {
            mostrarNotificacionError('Error de conexión', 'No se pudo conectar al servidor. Por favor, intenta nuevamente.');
            
            // Restaurar botón
            $('button[onclick*="' + codigoBeca + '"]').prop('disabled', false).html('<i class="fa fa-times" aria-hidden="true"></i>');
        });
    }

    // Función auxiliar para mostrar notificaciones de éxito
    function mostrarNotificacionExito(titulo, mensaje) {
        // Colores consistentes con el esquema negro y amarillo existente
        $('#modalExitoBeca .modal-header').css('background-color', '#333333');
        $('#tituloExito').html('<i class="fa fa-check-circle" aria-hidden="true" style="color: #fff500; margin-right: 10px;"></i>' + titulo);
        $('#contenidoExito').css({'background-color': '#fff500', 'color': '#333', 'border-left': 'none'});
        $('#mensajeExito').html(mensaje).css('color', '#333');
        $('#detalleExito').text('La operación se ha procesado correctamente.');
        $('#modalExitoBeca .btn').css('background-color', '#333333');
        $('#modalExitoBeca .btn i').css('color', '#fff500');
        
        $('#modalExitoBeca').modal('show');
        
        // Auto cerrar después de 4 segundos (tiempo estándar para éxito)
        setTimeout(function() {
            $('#modalExitoBeca').modal('hide');
        }, 4000);
    }

    // Función auxiliar para mostrar notificaciones de éxito sin auto-cerrar
    function mostrarNotificacionExitoSinAutoCerrar(titulo, mensaje) {
        // Colores consistentes con el esquema negro y amarillo existente
        $('#modalExitoBeca .modal-header').css('background-color', '#333333');
        $('#tituloExito').html('<i class="fa fa-check-circle" aria-hidden="true" style="color: #fff500; margin-right: 10px;"></i>' + titulo);
        $('#contenidoExito').css({'background-color': '#fff500', 'color': '#333', 'border-left': 'none'});
        $('#mensajeExito').html(mensaje).css('color', '#333');
        $('#detalleExito').text('Tu decisión ha sido registrada exitosamente.');
        $('#modalExitoBeca .btn').css('background-color', '#333333');
        $('#modalExitoBeca .btn i').css('color', '#fff500');
        
        $('#modalExitoBeca').modal('show');
        
        // No auto-cerrar - solo se cierra cuando el usuario haga clic en el botón
    }

    // Función auxiliar para mostrar notificaciones de error
    function mostrarNotificacionError(titulo, mensaje) {
        // Mantener el esquema negro y amarillo, pero usando rojo para indicar error
        $('#modalExitoBeca .modal-header').css('background-color', '#dc3545');
        $('#tituloExito').html('<i class="fa fa-times-circle" aria-hidden="true" style="color: #fff500; margin-right: 10px;"></i>' + titulo);
        $('#contenidoExito').css({'background-color': '#f8d7da', 'color': '#721c24', 'border-left': '4px solid #dc3545'});
        $('#mensajeExito').html(mensaje).css('color', '#721c24');
        $('#detalleExito').text('Por favor, verifica la información e intenta nuevamente.');
        $('#modalExitoBeca .btn').css('background-color', '#dc3545');
        $('#modalExitoBeca .btn i').css('color', '#fff500');
        
        $('#modalExitoBeca').modal('show');
        
        // Auto cerrar después de 5 segundos (más tiempo para leer el mensaje)
        setTimeout(function() {
            $('#modalExitoBeca').modal('hide');
        }, 5000);
        
        // Restaurar colores originales después de cerrar
        $('#modalExitoBeca').on('hidden.bs.modal', function() {
            $('#modalExitoBeca .modal-header').css('background-color', '#333333');
            $('#contenidoExito').css({'background-color': '#fff500', 'color': '#333', 'border-left': 'none'});
            $('#mensajeExito').css('color', '#333');
            $('#modalExitoBeca .btn').css('background-color', '#333333');
            $('#modalExitoBeca .btn i').css('color', '#fff500');
            $(this).off('hidden.bs.modal');
        });
    }

    // Función auxiliar para mostrar notificaciones informativas
    function mostrarNotificacionInfo(titulo, mensaje) {
        // Usar azul para información manteniendo iconos amarillos consistentes
        $('#modalExitoBeca .modal-header').css('background-color', '#007bff');
        $('#tituloExito').html('<i class="fa fa-info-circle" aria-hidden="true" style="color: #fff500; margin-right: 10px;"></i>' + titulo);
        $('#contenidoExito').css({'background-color': '#d1ecf1', 'color': '#0c5460', 'border-left': '4px solid #007bff'});
        $('#mensajeExito').html(mensaje).css('color', '#0c5460');
        $('#detalleExito').text('Esta es información importante para tu proceso de becas.');
        $('#modalExitoBeca .btn').css('background-color', '#007bff');
        $('#modalExitoBeca .btn i').css('color', '#fff500');
        
        $('#modalExitoBeca').modal('show');
        
        // Auto cerrar después de 4.5 segundos (más tiempo para leer información)
        setTimeout(function() {
            $('#modalExitoBeca').modal('hide');
        }, 4500);
        
        // Restaurar colores originales después de cerrar
        $('#modalExitoBeca').on('hidden.bs.modal', function() {
            $('#modalExitoBeca .modal-header').css('background-color', '#333333');
            $('#contenidoExito').css({'background-color': '#fff500', 'color': '#333', 'border-left': 'none'});
            $('#mensajeExito').css('color', '#333');
            $('#modalExitoBeca .btn').css('background-color', '#333333');
            $('#modalExitoBeca .btn i').css('color', '#fff500');
            $(this).off('hidden.bs.modal');
        });
    }
    </script>
