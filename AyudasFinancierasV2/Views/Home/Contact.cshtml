@{
    ViewBag.Title = "Contact";
}

<style>
    .btn-primaryYellow {
        background-color: #f0dc24 
    }
</style>
<div class="col-xl-8">
    <div class="card">
        <div class="card-header border-0 pb-0">
            <h5 class="card-title">.</h5>
        </div>
        <div class="card-body">
            <div class="row">


                <div class=" col-md-4">
                    <img src="~/Content/Img/carrera.png" alt="Alternate Text" />
                </div>
                <div class="col-md-8">
                    brr
                    <p class="text-center">Fundación Dr. Rodrigo F. Barragán Villarreal.</p>
                    
                </div>
            </div>
        </div>
        <div class="card-footer border-0 pt-0 card-link float-end">
            <div class="row">
                <div class="col-xl-8 col-xxl-8 col-8">
                    <button class="card-text d-inline btn btn-primaryYellow"><i style="color:white; text-align: right" class="fa fa-comment" aria-hidden="true"></i> Conoce más</button>
                </div>


                <div class="col-xl-4 col-xxl-4 col-4 right">
                    <div class="form-check custom-checkbox mb-3 checkbox-success">
                        <input type="checkbox" class="form-check-input" checked="" id="customCheckBox3" required="">
                        <label class="form-check-label" for="customCheckBox3">Aplicar a la beca.</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>