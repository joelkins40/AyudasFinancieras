            transform: scale(0.98) !important;
        }
    }
    /* Mejoras de accesibilidad táctil */
    @@media (hover: none) and (pointer: coarse) {
        .nav-wizard li .nav-link {
            min-height: 44px !important; /* Tamaño mínimo recomendado para touch */
            padding: 12px 15px !important;
        }
        .nav-wizard li .nav-link:hover {
            transform: none !important; /* Remover hover effects en dispositivos táctiles */
        }
        .nav-wizard li .nav-link:active {
            background: rgba(255, 245, 0, 0.2) !important;
            transform: scale(0.98) !important;
        }
