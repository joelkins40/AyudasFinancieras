    <script>


    function modalEstatus(name, code, estatus) {
        if (estatus === 'Completa') {




            if (code === 'BSA_APP_PRNA_VT' || code === 'BSA_APP_PRRE_VT' || code === 'BSA_APP_BANA_VT' || code === 'BSA_APP_BARE_VT') {
                $('#beca2').text(name);  // Cambiar el nombre del modal

                $('#fake').modal('show');
            } else {




                var mensaje = 'A';
                $('#documentos tbody').empty();  // Limpiar las filas existentes

                $('#beca').text(name);  // Cambiar el nombre del modal

                // Realizar la solicitud AJAX
                $.post("@Url.Action("getEstatus", "Home")", { item: '1' }, function (datas) {

                    // Obtener la instancia de DataTables (que ya está inicializada)
                    var table = $('#documentos').DataTable();
                    table.clear();

                    // Crear un array vacío para las nuevas filas
                    var newRows = [];

                    // Procesar los datos y agregarlos a un array
                    $.each(datas, function (index, item) {
                        var fila = [
                            item.descripcion,
                            item.estatus,
                            getIconByDocumento(item.documento)
                            // Llamamos a una función para obtener el ícono según el tipo de documento
                        ];
                        newRows.push(fila);  // Agregar la fila al array
                    });

                    // Agregar las nuevas filas a DataTables
                    table.rows.add(newRows);  // Añadir las filas a la tabla

                    // Redibujar la tabla para reflejar los cambios
                    table.draw();  // Forzar el redibujado de la tabla

                    // Mostrar el modal
                    $('#ok').modal('show');
                });
            }

        } else {
            $('#beca2').text(name);  // Cambiar el nombre del modal
            $('#beca4').text('Es necesario completar la solicitud, para poder visualizar esta sección');  // Cambiar el nombre del modal

            $('#fake').modal('show');
        }
}

// Función auxiliar para obtener el ícono de acuerdo al tipo de documento
function getIconByDocumento(documento) {
    if (documento === 'PS') {
        return '<i style="color:#d9534f;" class="fa fa-exclamation-circle" aria-hidden="true"></i>';
    } else if (documento === 'COMP' || documento === 'CM') {
        return '<i style="color:#28a745;" class="fa fa-check-circle" aria-hidden="true"></i>';
    } else if (documento === 'NR' || documento === 'PD') {
        return '<i style="color:#fd7e14;" class="fa fa-clock" aria-hidden="true"></i>';
    } else if (documento === 'IN' || documento === 'IV') {
        return '<i style="color:#e83e8c;" class="fa fa-ban" aria-hidden="true"></i>';
    } else {
        return '<i style="color:#6c757d;" class="fa fa-question-circle" aria-hidden="true"></i>';
    }
    }

    function getFile(clave) {
        var width = 800; // Ancho de la ventana
        var height = 600; // Altura de la ventana
        var left = (screen.width / 2) - (width / 2); // Centrar horizontalmente
        var top = (screen.height / 2) - (height / 2); // Centrar verticalmente
        window.open('/Home/DisplayDocument/?documento=' + clave, '_blank', `top=${top},left=${left},width=${width},height=${height},toolbar=1,resizable=1`);
    }

    // Funcionalidad para los botones "Más" del historial de renovaciones
    $(document).ready(function() {
        // Escuchar eventos de colapso para cambiar el ícono del botón
        $('[id^="detalleRenovacion"]').on('show.bs.collapse', function () {
            var currentId = this.id;

            // Cerrar todos los otros detalles de renovación antes de abrir el actual
            $('[id^="detalleRenovacion"]').each(function() {
                if (this.id !== currentId && $(this).hasClass('show')) {
                    $(this).collapse('hide');
                }
            });

            var button = $('[data-bs-target="#' + this.id + '"]');
            button.find('i').removeClass('fa-plus').addClass('fa-minus');
        });

        $('[id^="detalleRenovacion"]').on('hide.bs.collapse', function () {
            var button = $('[data-bs-target="#' + this.id + '"]');
            button.find('i').removeClass('fa-minus').addClass('fa-plus');
        });
    });
    </script>
