</style>
<div class="container-fluid">
    <div class="d-flex align-items-stretch" style="background-color:#333; min-height: 100px;">
        <div class="flex-grow-1 d-flex align-items-center justify-content-between pe-4">
            <div class="d-flex align-items-center">
                <img class="img-fluid" 
                     style="height: 100%; max-height: 100px; width: auto; object-fit: contain;" 
                     src="https://www.udem.edu.mx/sites/default/files/udem-logotipo-principal.png" 
                     alt="Logo UDEM" 
                     onerror="this.style.display='none'" />
                <div class="text-white d-none d-lg-block ms-3">
                    <h6 class="mb-0 fw-bold">Universidad de Monterrey</h6>
                    <small class="opacity-75">Sistema de Ayudas Financieras</small>
                </div>
            </div>
            <div class="text-white text-end d-none d-md-block">
                <small class="opacity-75">Portal de Becas</small>
                <br>
                <small class="opacity-50">2025</small>
            </div>
        </div>
    </div>
    <div class="row g-0">
        <div class="col-12">
            <div class="card border-0" style="height:auto">
                <div class="card-body p-3 p-md-4">
                    <div id="smartwizard" class="form-wizard order-create">
                        <ul class="nav nav-wizard yellow">
                            <li>
                                <a class="nav-link d-flex align-items-center" href="#datos1" onclick="return false;">
                                    <i class="fas fa-user iconos me-2" aria-hidden="true"></i>
                                    <span>Información General</span>
                                </a>
                                <i class="fa fa-chevron-right ms-3 separator-icon d-none d-md-inline" aria-hidden="true"></i>
                            </li>
                            <li>
                                <a class="nav-link d-flex align-items-center" href="#datos2" onclick="return false;">
                                    <i class="fas fa-book iconos me-2" aria-hidden="true"></i>
                                    <span>Información Académica</span>
                                </a>
                                <i class="fa fa-chevron-right ms-3 separator-icon d-none d-md-inline" aria-hidden="true"></i>
                            </li>
                            <li>
                                <a class="nav-link d-flex align-items-center" href="#datos3" onclick="return false;">
                                    <i class="fas fa-university iconos me-2" aria-hidden="true"></i>
                                    <span>Información Formativa</span>
                                </a>
                                <i class="fa fa-chevron-right ms-3 separator-icon d-none d-md-inline" aria-hidden="true"></i>
                            </li>
                            <li>
                                <a class="nav-link d-flex align-items-center" href="#datos4" onclick="return false;">
                                    <i class="fas fa-dollar-sign iconos me-2" aria-hidden="true"></i>
                                    <span>Información Económica</span>
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div id="datos1" class="tab-pane" role="tabpanel">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <h1 class="h2 mb-3 mb-md-4 pb-2 pb-md-3 fw-bold text-black ms-2 ms-md-3">Información General</h1>
                                        <div class="validation-summary">
                                            <strong>Por favor complete todos los campos requeridos antes de continuar.</strong>
                                        </div>
                                    </div>
                                    @foreach (var item1 in ViewBag.preguntas)
                                    {
                                        if (item1.categoria.Equals("1"))
                                        {
                                            <div class="col-lg-12 mb-2">
                                                <div class="form-group">
                                                    @if (item1.posicion.Contains("."))
                                                    {
                                                        <div class="ms-3">
                                                            <span class="@(!item1.oculta.Equals("") ? "V" + item1.oculta.Replace(".", "") : "")" @(!item1.oculta.Equals("") ? " hidden " : "")>
                                                                @item1.posicion. @item1.pregunta
                                                                @if (!item1.comentario.Equals(""))
                                                                {
                                                                    <i class="fa fa-info-circle iconos"
                                                                       data-bs-toggle="tooltip"
                                                                       data-bs-placement="top"
                                                                       title="@item1.comentario"
                                                                       style="cursor:pointer; font-size: 1.2em; margin-right: 0.4em;"></i>
                                                                }
                                                            </span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <h4 class="h4-letter-spacing">
                                                            @item1.posicion.
                                                            <span class="ms-3">@item1.pregunta</span>
                                                            @if (!item1.comentario.Equals(""))
                                                            {
                                                                <span class="info-tooltip-wrapper"
                                                                   data-bs-toggle="tooltip"
                                                                   data-bs-placement="top"
                                                                   title="@item1.comentario"
                                                                   style="cursor:pointer;"><i class="fas fa-question-circle text-custom-orange me-1" style="font-size: 1.1em;"></i><small class="text-custom-orange fw-bold">Conoce más</small></span>
                                                            }
                                                        </h4>
                                                    }
                                                    <div class="mb-3">
                                                        @if (item1.tipo.Equals("RD"))
                                                        {
                                                            foreach (var opt in item1.opciones)
                                                            {
                                                                <div class="form-check form-check-inline ms-3">
                                                                    <label class="form-check-label">
                                                                        <input type="radio" name="@item1.tipo@item1.id" class="form-check-input input-radio-lg" value="@opt.valor" @(item1.respuesta.Equals(opt.valor) ? "checked" : "")>
                                                                        @opt.descripcion
                                                                    </label>
                                                                </div>
                                                            }
                                                            if (item1.otro.Equals("SI"))
                                                            {
                                                                <div class="form-check form-check-inline ms-3 disabled">
                                                                    <input type="text" name="firstName" class="form-control solo-visible" placeholder="Nacionalidad" readonly required>
                                                                </div>
                                                            }
                                                        }
                                                        @if (item1.tipo.Equals("CB"))
                                                        {
                                                            <div class="col-lg-6 mb-2  @(item1.oculta.Equals("") ? "ms-1" : "ms-5") @(!item1.oculta.Equals("") ? "V" + item1.oculta.Replace(".", "") + "" : "")" @(!item1.oculta.Equals("") ? " hidden " : "")>
                                                                <div class="form-group">
                                                                    <div class="dropdown bootstrap-select default-select form-control wide">
                                                                        <select name="CB_@item1.tipo@item1.id" id="@item1.tipo@item1.id" class="default-select form-control wide" tabindex="null">
                                                                            <option>Seleccionar opción</option>
                                                                            @foreach (var opt in item1.opciones)
                                                                            {
                                                                                <option value="@opt.valor" @(item1.respuesta != null && item1.respuesta.Equals(opt.valor) ? "selected" : "")>@opt.descripcion</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (item1.tipo.Equals("CBM"))
                                                        {
                                                            <div class="col-lg-6 mb-2  @(item1.oculta.Equals("") ? "ms-1" : "ms-5") @(!item1.oculta.Equals("") ? "V" + item1.oculta.Replace(".", "") + "" : "")" @(!item1.oculta.Equals("") ? " hidden " : "")>
                                                                <div class="form-group">
                                                                    <div class="dropdown bootstrap-select default-select form-control wide">
                                                                        <select name="CB_@item1.tipo@item1.id" id="@item1.tipo@item1.id" class="default-select form-control wide" tabindex="null" multiple data-none-selected-text="Seleccione una opción">
                                                                            @{
                                                                                var respuestasSeleccionadas = item1.respuesta != null ? item1.respuesta.Split(',') : new string[] { };
                                                                            }
